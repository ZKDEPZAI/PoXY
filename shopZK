                    <div class="bg-black/60 p-3 rounded border border-teal-500/20 space-y-2">
                        <p class="font-bold text-electric-teal uppercase text-[10px]">Tính năng bản đồ</p>
                        <div class="grid grid-cols-2 gap-2">
                            <label class="flex items-center gap-2"><input type="checkbox" checked class="accent-teal-400"> Vẽ ESP Toàn Bản Đồ</label>
                            <label class="flex items-center gap-2"><input type="checkbox" checked class="accent-teal-400"> Hiện Hồi Chiêu Địch</label>
                            <label class="flex items-center gap-2"><input type="checkbox" class="accent-teal-400"> Sáng Vùng Rừng</label>
                            <label class="flex items-center gap-2"><input type="checkbox" class="accent-teal-400"> Ẩn Menu An Toàn</label>
                        </div>
                    </div>
                `;
            } else if (type === 'ff_aimdrag') {
                titleEl.innerHTML = `<i class="fa-solid fa-gamepad mr-1"></i> Free Fire - Aimdrag VIP`;
                bodyEl.innerHTML = `
                    <div class="bg-black/60 p-3 rounded border border-teal-500/20 space-y-2">
                        <p class="font-bold text-electric-teal uppercase text-[10px]">Tùy Chỉnh Aimdrag</p>
                        <div class="grid grid-cols-2 gap-2">
                            <label class="flex items-center gap-2"><input type="checkbox" checked class="accent-teal-400"> Kéo Tâm Siêu Nhạy</label>
                            <label class="flex items-center gap-2"><input type="checkbox" checked class="accent-teal-400"> Bám Đầu Địch</label>
                            <label class="flex items-center gap-2"><input type="checkbox" class="accent-teal-400"> Chống Lệch Tâm</label>
                            <label class="flex items-center gap-2"><input type="checkbox" class="accent-teal-400"> Giảm Giật Súng</label>
                        </div>
                    </div>
                `;
            } else if (type === 'ff_aimbody') {
                titleEl.innerHTML = `<i class="fa-solid fa-gamepad mr-1"></i> Free Fire - Aimbody Pro`;
                bodyEl.innerHTML = `
                    <div class="bg-black/60 p-3 rounded border border-teal-500/20 space-y-2">
                        <p class="font-bold text-electric-teal uppercase text-[10px]">Tùy Chỉnh Aimbody</p>
                        <div class="grid grid-cols-2 gap-2">
                            <label class="flex items-center gap-2"><input type="checkbox" checked class="accent-teal-400"> Khóa Tâm Thân</label>
                            <label class="flex items-center gap-2"><input type="checkbox" class="accent-teal-400"> Tự Động Bắt Mục Tiêu</label>
                        </div>
                    </div>
                `;
            } else if (type === 'ff_magic') {
                titleEl.innerHTML = `<i class="fa-solid fa-gamepad mr-1"></i> Free Fire - Aim Magic Bullet`;
                bodyEl.innerHTML = `
                    <div class="bg-black/60 p-3 rounded border border-teal-500/20 space-y-2">
                        <p class="font-bold text-electric-teal uppercase text-[10px]">Tùy Chỉnh Magic Bullet</p>
                        <div class="grid grid-cols-2 gap-2">
                            <label class="flex items-center gap-2"><input type="checkbox" checked class="accent-teal-400"> Uốn Cong Đường Đạn</label>
                            <label class="flex items-center gap-2"><input type="checkbox" class="accent-teal-400"> Bắn Xuyên Góc Tường</label>
                        </div>
                    </div>
                `;
            } else if (type === 'ff_antena') {
                titleEl.innerHTML = `<i class="fa-solid fa-gamepad mr-1"></i> Free Fire - Antena + Kéo Dài Cổ`;
                bodyEl.innerHTML = `
                    <div class="bg-black/60 p-3 rounded border border-teal-500/20 space-y-2">
                        <p class="font-bold text-electric-teal uppercase text-[10px]">Tùy Chỉnh Antena & Cổ</p>
                        <div class="grid grid-cols-2 gap-2">
                            <label class="flex items-center gap-2"><input type="checkbox" checked class="accent-teal-400"> Antena Tầm Nhìn Xa</label>
                            <label class="flex items-center gap-2"><input type="checkbox" checked class="accent-teal-400"> Kéo Dài Cổ Địch</label>
