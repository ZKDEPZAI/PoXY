    <script>
        let dbUsers = JSON.parse(localStorage.getItem('zk_store_users_v5')) || {};
        let currentUser = localStorage.getItem('zk_store_logged_v5') || null;
        let dbOrders = JSON.parse(localStorage.getItem('zk_store_orders_v5')) || [];

        let selectedPackages = {
            'lq-map': { name: '1 Tuần', price: 50000 },
            'ff-aimdrag': { name: '1 Tuần', price: 40000 },
            'ff-aimbody': { name: '1 Tuần', price: 45000 },
            'ff-magic': { name: '1 Tuần', price: 60000 },
            'ff-antena': { name: '1 Tuần', price: 35000 }
        };

        function selectPackage(productId, pkgName, price) {
            selectedPackages[productId] = { name: pkgName, price: price };
            document.getElementById('price-' + productId).innerText = price.toLocaleString() + 'đ';
            
            const container = document.getElementById('pkg-' + productId);
            container.querySelectorAll('button').forEach(btn => {
                if (btn.innerText.includes(pkgName)) {
                    btn.classList.add('selected');
                } else {
                    btn.classList.remove('selected');
                }
            });
        }

        function setDepositAmount(amount) {
            document.getElementById('inputDepositAmount').value = amount;
        }

        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        function openMenuModal(type) {
            const titleEl = document.getElementById('menuModalTitle');
            const bodyEl = document.getElementById('menuModalBody');

            if (type === 'lq') {
                titleEl.innerHTML = `<i class="fa-solid fa-gamepad mr-1"></i> Liên Quân Mobile (S1) - Map Sáng`;
