        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.bottom-nav-item').forEach(el => el.classList.remove('active'));

            document.getElementById('tab-' + tabName).classList.add('active');
            
            const mapNav = { 'shop': 0, 'seller': 1, 'nap': 2, 'don': 3, 'hotro': 4 };
            if (mapNav[tabName] !== undefined) {
                const items = document.querySelectorAll('.bottom-nav-item');
                if (items[mapNav[tabName]]) items[mapNav[tabName]].classList.add('active');
            }

            if (tabName === 'don') renderOrders();
            if (tabName === 'taikhoan') updateUIAuth();
        }

        window.onload = function() { updateUIAuth(); };

        function updateUIAuth() {
            if (currentUser && dbUsers[currentUser]) {
                document.getElementById('headerAuthArea').innerHTML = `
                    <div onclick="switchTab('taikhoan')" class="flex items-center gap-2 bg-[#161b22] border border-electric-teal/40 px-3 py-1 rounded-full cursor-pointer">
                        <span class="text-xs font-bold text-white">${currentUser}</span>
                        <span class="text-[10px] text-electric-teal font-mono">${dbUsers[currentUser].balance.toLocaleString()}đ</span>
                    </div>
                `;
                document.getElementById('guestAccountView').style.display = 'none';
                document.getElementById('userAccountView').style.display = 'block';
                document.getElementById('accUsernameDisplay').innerText = currentUser;
                document.getElementById('accBalanceDisplay').innerText = dbUsers[currentUser].balance.toLocaleString() + " đ";
            } else {
                document.getElementById('headerAuthArea').innerHTML = `
                    <button onclick="openModal('loginModal')" class="border border-white/25 hover:border-electric-teal px-3 py-1.5 rounded text-xs font-bold text-white transition cursor-pointer cyber-clip bg-black/40">ĐĂNG NHẬP</button>
                    <button onclick="openModal('registerModal')" class="bg-electric-teal text-black px-3 py-1.5 rounded text-xs font-black transition cursor-pointer cyber-clip">ĐĂNG KÝ</button>
                `;
                document.getElementById('guestAccountView').style.display = 'block';
                document.getElementById('userAccountView').style.display = 'none';
            }
        }

        function handleRegister(e) {
            e.preventDefault();
            const u = document.getElementById('regUser').value.trim();
            const p = document.getElementById('regPass').value;
            if (dbUsers[u]) { alert("Tài khoản đã tồn tại!"); return; }
            dbUsers[u] = { pass: p, balance: 20000, syntax: "ZK" + u.toUpperCase().replace(/[^A-Z0-9]/g, '') + Math.floor(100 + Math.random() * 900) };
            localStorage.setItem('zk_store_users_v5', JSON.stringify(dbUsers));
            alert("Đăng ký thành công! Tặng kèm 20k vào tài khoản.");
            closeModal('registerModal');
            openModal('loginModal');
        }

        function handleLogin(e) {
            e.preventDefault();
            const u = document.getElementById('loginUser').value.trim();
            const p = document.getElementById('loginPass').value;
            if (!dbUsers[u] || dbUsers[u].pass !== p) { alert("Sai tài khoản hoặc mật khẩu!"); return; }
            currentUser = u;
            localStorage.setItem('zk_store_logged_v5', u);
            updateUIAuth();
            closeModal('loginModal');
            alert("Đăng nhập thành công!");
        }

        function logout() {
            localStorage.removeItem('zk_store_logged_v5');
            currentUser = null;
            updateUIAuth();
            switchTab('shop');
        }

        function createDepositRequest() {
            if (!currentUser) { alert("Vui lòng đăng nhập!"); openModal('loginModal'); return; }
            const amount = parseInt(document.getElementById('inputDepositAmount').value);
            if (isNaN(amount) || amount < 10000) { alert("Nhập số tiền từ 10.000đ trở lên!"); return; }
            const userData = dbUsers[currentUser];
            const qrUrl = `https://img.vietqr.io/image/ICB-103880313862-compact2.png?amount=${amount}&addInfo=${userData.syntax}&accountName=LO%20DUONG%20TU`;
            document.getElementById('vietQrImg').src = qrUrl;
            document.getElementById('syntaxText').innerText = userData.syntax;
            document.getElementById('qrContainer').style.display = 'block';
            alert("Đã tạo yêu cầu nạp tiền!");
        }

        function buyProxyProduct(baseName, productKey) {
            if (!currentUser) { alert("Vui lòng đăng nhập!"); openModal('loginModal'); return; }
            const pkg = selectedPackages[productKey];
            const fullName = `${baseName} (${pkg.name})`;
            const price = pkg.price;
            const user = dbUsers[currentUser];
            if (user.balance < price) { alert("Số dư không đủ!"); switchTab('nap'); return; }
            if (confirm(`Xác nhận mua [${fullName}] với giá ${price.toLocaleString()}đ?`)) {
                user.balance -= price;
                localStorage.setItem('zk_store_users_v5', JSON.stringify(dbUsers));
                updateUIAuth();
                const licenseKey = "ZK-" + Math.random().toString(36).substring(2, 8).toUpperCase() + "-" + Math.random().toString(36).substring(2, 8).toUpperCase();
                dbOrders.unshift({ user: currentUser, item: fullName, price: price, key: licenseKey, time: new Date().toLocaleString() });
                localStorage.setItem('zk_store_orders_v5', JSON.stringify(dbOrders));
                alert(`🎉 Mua hàng thành công!\nKey của bạn: ${licenseKey}`);
                switchTab('don');
            }
        }

        function renderOrders(filterText = '') {
            const container = document.getElementById('orderListContainer');
            const myOrders = dbOrders.filter(o => o.user === currentUser);
            if (myOrders.length === 0) { container.innerHTML = `<p class="text-xs text-gray-400 font-mono text-center py-4">Chưa có giao dịch.</p>`; return; }
            let filtered = filterText ? myOrders.filter(o => o.item.toLowerCase().includes(filterText.toLowerCase()) || o.key.toLowerCase().includes(filterText.toLowerCase())) : myOrders;
            container.innerHTML = filtered.map(ord => `
                <div class="bg-black/50 border border-white/10 p-3 rounded-lg space-y-1.5 font-mono text-xs">
                    <div class="flex justify-between text-white font-bold"><span>${ord.item}</span><span class="text-electric-teal">${ord.price.toLocaleString()}đ</span></div>
                    <div class="text-[10px] text-gray-400">Thời gian: ${ord.time}</div>
                    <div class="bg-teal-500/10 border border-teal-500/30 p-2 rounded flex justify-between items-center">
                        <span class="text-electric-teal font-black">Key: ${ord.key}</span>
                        <button onclick="navigator.clipboard.writeText('${ord.key}'); alert('Đã copy Key!');" class="bg-electric-teal text-black px-2 py-1 rounded text-[10px] font-bold cursor-pointer">Copy</button>
                    </div>
                </div>
            `).join('');
        }

        function searchOrders() { renderOrders(document.getElementById('searchKeyInput').value.trim()); }
    </script>
