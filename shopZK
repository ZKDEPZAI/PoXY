    <style>
        :root {
            --font-space-grotesk: 'Space Grotesk', sans-serif;
            --font-orbitron: 'Orbitron', sans-serif;
            --electric-teal: #30bbaf;
            --electric-teal-glow: rgba(48, 187, 175, 0.4);
            --deep-void: #0b0e17;
            --deep-void-black: #05070b;
        }

        body {
            font-family: var(--font-space-grotesk);
            background-color: var(--deep-void-black);
            color: #ffffff;
            overflow-x: hidden;
            scroll-behavior: smooth;
            padding-bottom: 80px;
        }

        .orbitron-text { font-family: var(--font-orbitron); }
        .glow-text-teal { text-shadow: 0 0 12px var(--electric-teal-glow), 0 0 25px rgba(48, 187, 175, 0.2); }

        .bg-background-grid {
            background-image: linear-gradient(rgba(48, 187, 175, 0.02) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(48, 187, 175, 0.02) 1px, transparent 1px);
            background-size: 25px 25px;
        }

        .cyber-clip {
            clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
        }

        .product-card {
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }
        .product-card:hover {
            transform: translateY(-4px);
            border-color: var(--electric-teal);
            box-shadow: 0 10px 25px rgba(48, 187, 175, 0.15);
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .bottom-nav-item.active {
            color: var(--electric-teal);
        }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.85);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
        }

        .package-btn.selected {
            background-color: var(--electric-teal);
            color: black;
            border-color: var(--electric-teal);
            font-weight: 900;
        }
    </style>
</head>
